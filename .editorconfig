#=====================================================================
# MushIMTip .editorconfig - editor save-format conventions (matches .gitattributes)
#
#   *.ps1  UTF-8 with BOM   (required by Windows PowerShell 5.1)
#=====================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[{*.cmd,*.bat}]
charset = utf-8
end_of_line = crlf
